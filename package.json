{
  "name": "keymesh",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "description": "KeyMesh v2: credential vault mã hoá đầu-cuối, offline-first",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "start": "node testkit/serve.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "test:browser": "node testkit/browser/run.mjs",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=180000 \"test/e2e/*.e2e.js\"",
    "test:server": "node --test --test-concurrency=1 --test-timeout=300000 \"test/server/*.server.js\"",
    "dev:server": "node testkit/dev-server.mjs",
    "vectors": "node testkit/gen-vectors.mjs",
    "sw-version": "node testkit/sw-version.mjs"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
